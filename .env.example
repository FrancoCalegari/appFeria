# Base de datos (SQLite local por defecto; cambiar a URL del servicio SQL en la nube en producción)
DATABASE_URL=./feria.db
# DATABASE_PROVIDER=sqlite | cloud-sql

# Secreto para firmar cookies de sesión (ADMIN y VENDOR)
AUTH_SECRET=feria-de-las-heras-secret-key-2026

# Almacenamiento de archivos (local guarda en public/uploads; cloud envía al servicio Cloud Storage propio)
STORAGE_DRIVER=local
CLOUD_STORAGE_URL=https://storage.tudominio.com/api/upload
CLOUD_STORAGE_KEY=tu-api-key-cloud-storage

